# Copy these names — never the values — when setting up a new machine.
# Real values live at ~/.config/fawaky/env (mode 600, outside this repo),
# and in the Vercel dashboard for production builds.

# Google Maps JavaScript API key, used by the Fawaky Stations locator.
# Browser-facing: it ships in the built bundle by design. Protect it with
# HTTP-referrer + API restrictions in Google Cloud Console, not by hiding it.
VITE_GOOGLE_MAPS_API_KEY=
